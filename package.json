{
  "name": "origin-front-admin",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "run-p -l type-check:watch start:dev",
    "start:dev": "vite --open",
    "start:e2e": "vite build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "build": "run-p -l type-check build:prod",
    "build:prod": "npm run clean && vite build",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "test": "vitest -c ./config/test/config.ts",
    "test:ci": "vitest run -c ./config/test/config.ts",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e:cypress": "start-server-and-test start:e2e http://127.0.0.1:5173 cy:run",
    "e2e:playwright": "playwright test",
    "clean": "rimraf dist"
  },
  "imports": {
    "#*": "./src/*"
  },
  "author": "Lemoncode",
  "license": "MIT",
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lemoncode/fonk": "^1.5.4",
    "@lemoncode/fonk-formik": "^4.0.1",
    "@lemoncode/fonk-match-field-validator": "^1.0.1",
    "@lemoncode/fonk-required-by-field-validator": "^1.0.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.1",
    "formik": "^2.4.9",
    "graphql-request": "^7.4.0",
    "immer": "^11.1.11",
    "lodash.flowright": "^3.5.0",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-promise-tracker": "^2.1.1",
    "react-router-dom": "^7.18.1",
    "react-spinners": "^0.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^16.1.1",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
